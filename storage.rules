rules_version = '2';

// Security rules for the private GCS buckets accessed via the Firebase Storage SDK
// (see @n20a/libfsdb's FirebaseStorageProvider / useFirebaseStorage()).
// No object in these buckets is publicly readable/writable — every request must
// carry a valid Firebase Auth ID token.
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Mirrors the previous Cloud Run per-file cap; tighten per-folder if needed.
    function isWithinSizeLimit() {
      return request.resource.size < 500 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isWithinSizeLimit();
      allow delete: if isAuthenticated();
    }
  }
}
