{
  "name": "sm20",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/sync-all-config.js",
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/sync-all-config.js --env .env.production && vite build",
    "start": "vite preview --port 3000",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:zip": "npm run build && node scripts/deploy.js",
    "sync-config": "node scripts/sync-all-config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "preinstall": "node -e \"const v=parseInt(process.versions.node.split('.')[0]); if(v<24){process.stderr.write('WARNING: Node '+process.versions.node+' detected. Node >=24.0.0 is required.\\n');}\"",
    "prebuild": "nvm use 24"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@heroicons/react": "^2.2.0",
    "@mui/material": "^7.0.1",
    "@n20a/libalerts": "^1.1.10",
    "@n20a/libauth": "^1.3.21",
    "@n20a/libavnotes": "^1.2.27",
    "@n20a/libaxios": "^1.0.3",
    "@n20a/libcart": "^1.0.13",
    "@n20a/libchart": "^1.1.8",
    "@n20a/libclientidentity": "^1.0.9",
    "@n20a/libcountry": "^1.0.1",
    "@n20a/libflippdf": "^1.0.11",
    "@n20a/libform": "^1.3.47",
    "@n20a/libfsdb": "^1.0.20",
    "@n20a/libicon": "^1.2.26",
    "@n20a/libmiscfn": "^1.1.10",
    "@n20a/libreport": "^1.2.47",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "file-saver": "^2.0.5",
    "html-react-parser": "^5.2.11",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "prettier": "^3.9.9",
    "primereact": "^10.9.7",
    "prism-react-renderer": "^2.4.1",
    "rc-tree": "^5.13.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-error-boundary": "^6.1.3",
    "react-router-dom": "^7.5.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "styled-components": "^6.1.17",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.16",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@firebase/util@1.15.2": true,
