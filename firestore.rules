rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── REUSABLE CORE HELPER FUNCTIONS ──────────────────────────────────────
    
    // Checks if the incoming request is fully authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Resolves if the authenticated user matches a specific document property field
    function isOwner(resourceData) {
      return request.auth.uid == resourceData.createdby || 
             request.auth.uid == resourceData.salesexec ||
             request.auth.token.email == resourceData.salesexec;
    }

    // Validates that the payload contains mandatory structural identifiers
    function hasValidTrackingFields() {
      return request.resource.data.bid != null && 
             request.resource.data.dateupdated != null;
    }


    // ─── 📁 ROOT NODE: BUSINESSES ──────────────────────────────────────────
    match /businesses/{bid} {
      // Anyone authenticated can read business profiles, but only the owner/exec can edit
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasValidTrackingFields();
      allow update, delete: if isAuthenticated() && isOwner(resource.data);

      // ─── 📂 SUBCOLLECTION: CONTACTS ───
      match /contacts/{cid} {
        allow read, write: if isAuthenticated() && (
          // Inherit security boundary checks directly from the parent business record
          isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
        );
      }

      // ─── 📂 SUBCOLLECTION: NOTES ───
      match /notes/{noteid} {
        allow read, write: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
        );
      }

      // ─── 📂 SUBCOLLECTION: ACTIVITIES ───
      match /activities/{activityid} {
        allow read, write: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
        );
      }

      // ─── 📂 SUBCOLLECTION: ORDERS ───
      match /orders/{orderid} {
        allow read, write: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
        );

        // ─── 📂 DEEP NESTED SUBCOLLECTION: CARTS ───
        match /carts/{cartid} {
          allow read, write: if isAuthenticated() && (
            isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
          );
        }

        // ─── 📂 DEEP NESTED SUBCOLLECTION: SUPPORTHOURSUSED ───
        match /supporthoursused/{entryid} {
          allow read, write: if isAuthenticated() && (
            isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
          );
        }
      }

      // ─── 📂 SUBCOLLECTION: TICKETS ───
      match /tickets/{ticketid} {
        allow read, write: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
        );

        // ─── 📂 DEEP NESTED SUBCOLLECTION: TICKETNOTES ───
        match /ticketnotes/{noteid} {
          allow read, write: if isAuthenticated() && (
            isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
          );
        }
      }

      // ─── 📂 SUBCOLLECTION: SUBS ───
      match /subs/{subsid} {
        allow read, write: if isAuthenticated() && (
          isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
        );

        // ─── 📂 DEEP NESTED SUBCOLLECTION: DOWNLOADS ───
        match /downloads/{downloadid} {
          allow read, write: if isAuthenticated() && (
            isOwner(get(/databases/$(database)/documents/businesses/$(bid)).data)
          );
        }
      }
    }


    // ─── 📁 ROOT NODE: TODO ────────────────────────────────────────────────
    match /todo/{todoid} {
      // Users can see and update their specific assigned tasks linked by bid pointer
      allow read, write: if isAuthenticated() && (
        isOwner(get(/databases/$(database)/documents/businesses/$(resource.data.bid)).data)
      );
    }


    // ─── 📁 ROOT NODE: PROSPECT ────────────────────────────────────────────
    match /prospect/{cid} {
      // Inbound prospects don't have an owner yet, so any logged-in representative can view or claim them
      allow read, create: if isAuthenticated();
      // Only system verification processes or authorized execs can modify/delete leads
      allow update, delete: if isAuthenticated();
    }

  }
}
